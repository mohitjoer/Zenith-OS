#!/bin/sh
# Runs hypridle with the idle timeouts from org.asura.desktop.
#
# hypridle cannot read GSettings. The timeouts go in as environment variables
# that hypridle.conf tests with `# hyprlang if`: a timeout of 0 (never) leaves
# its variable unset, and its listener is skipped.
#
#   asura-idle start    what asura-idle service runs
#   asura-idle apply    restart the service if the timeouts changed since it
#                        started; asura-shell calls this when a setting is written
set -eu

RUN=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}

# The materialized copy wins, so a user edit does; the packaged one covers a
# session that has not been materialized yet.
conf=$HOME/.config/asura/hyprland/hypridle.conf
[ -r "$conf" ] || conf=/usr/share/asura/hyprland/hypridle.conf

# secs KEY DEFAULT: the key's value, or DEFAULT when gsettings cannot answer.
secs() {
    v=$(gsettings get org.asura.desktop "$1" 2>/dev/null) || v=$2
    v=${v##* }
    case $v in '' | *[!0-9]*) v=$2 ;; esac
    echo "$v"
}
# The defaults are the schema's.
timeouts() {
    echo "$(secs idle-dim-seconds 0) $(secs idle-blank-seconds 0) $(secs idle-lock-seconds 300)"
}

case ${1:-start} in
start)
    set -- $(timeouts)
    echo "$*" > "$RUN/asura-idle.args"
    : > "$RUN/asura-idle"
    if [ "$1" -gt 0 ]; then export ASURA_IDLE_DIM=$1; fi
    if [ "$2" -gt 0 ]; then export ASURA_IDLE_BLANK=$2; fi
    if [ "$3" -gt 0 ]; then export ASURA_IDLE_LOCK=$3; fi
    # hypridle 0.1.7 aborts when given -c unless a config also exists on its
    # default search path (fixed in 0.1.8). XDG_CONFIG_DIRS gives it one to find.
    mkdir -p "$RUN/asura-idle.d/hypr"
    ln -sf "$conf" "$RUN/asura-idle.d/hypr/hypridle.conf"
    export XDG_CONFIG_DIRS="$RUN/asura-idle.d:${XDG_CONFIG_DIRS:-/etc/xdg}"
    exec hypridle -c "$conf"
    ;;
apply)
    if [ "$(timeouts)" != "$(cat "$RUN/asura-idle.args" 2>/dev/null)" ]; then
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user try-restart asura-idle.service
        elif [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/service/asura-idle" ] && command -v sv >/dev/null 2>&1; then
            sv restart "${XDG_CONFIG_HOME:-$HOME/.config}/service/asura-idle" 2>/dev/null || true
        else
            pkill -x hypridle 2>/dev/null || true
        fi
    fi
    ;;
*)
    echo "usage: asura-idle [start|apply]" >&2
    exit 2
    ;;
esac
