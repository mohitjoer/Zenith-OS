# Asura idle policy (hypridle).
#
# The stages, the timeouts and why hypridle is wrapped are in
# session/hyprland/hypridle.conf and session/asura-idle. Without hypridle
# installed the condition below skips the unit instead of letting it fail in a
# restart loop; the Lockscreen page says so.
[Unit]
Description=Asura idle policy (hypridle)
Documentation=https://github.com/mohitjoer/Asura-OS
PartOf=graphical-session.target
After=asura-session.target
Requires=asura-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionFileIsExecutable=/usr/bin/hypridle
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/bin/asura-idle start
Restart=on-failure
RestartSec=1
Slice=app.slice

[Install]
WantedBy=asura-session.target
