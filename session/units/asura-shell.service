# Asura shell (Quickshell).
#
# After=asura-portal.service is the line that is easiest in the session to get
# wrong, because both sides of it work individually and the failure is quiet. The
# Hyprland backend shells out to grim, slurp and hyprpicker, and does not create
# the Screenshot portal at all when grim is missing — so a screenshot keybinding
# produces nothing rather than an error. The dispatcher resolves its backends
# once at startup and never re-reads them, so the shell has to wait for the
# dispatcher to have made that decision.
#
# Requires=asura-session.target, not just After=: without it the shell is
# merely ordered, so pulling the compositor target down leaves the shell running
# against a display that is no longer there.
#
# After=asurad.service (with Wants=) is the other ordering that matters, and
# the reason is a Quickshell fact: a Socket whose first connect fails fires no
# state-change signal, so the dozen services in the shell that connect to the
# daemon once at load never try again, and every panel they feed stays empty for
# the rest of the session. asurad.service does not count as started until its
# socket exists (see the ExecStartPost there), so ordering after it is ordering
# after the socket. Wants= and not Requires=: a daemon that cannot start is a
# degraded desktop, and a shell that refuses to start because of it is no
# desktop at all.
[Unit]
Description=Asura shell (Quickshell)
Documentation=https://github.com/mohitjoer/Asura-OS
PartOf=graphical-session.target
After=asura-session.target asura-portal.service asurad.service wireplumber.service
Wants=asurad.service
Requires=asura-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# A shell that has to be killed nine times in thirty seconds is a shell that
# cannot start; give up rather than spin.
#
# These two live in [Unit], not [Service]. systemd reads the rate limiter from
# the unit, and systemd-analyze verify says so plainly — "Unknown key
# 'StartLimitIntervalSec' in section [Service], ignoring" — which is the
# difference between a limiter that works and one that was never applied.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/bin/quickshell -p /usr/share/asura/shell
ExecReload=/bin/kill -SIGUSR1 $MAINPID
Restart=on-failure
RestartSec=1
Slice=app.slice

[Install]
WantedBy=asura-session.target
