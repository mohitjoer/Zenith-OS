# Zenith portal dispatcher.
#
# A shadow of the base layer's own xdg-desktop-portal.service under a zenith-
# name, which is the pattern the base-layer boundary prescribes for a component
# that needs different configuration: never an edit in place, always a drop-in of
# your own. The base layer's unit must not also be enabled — two dispatchers on
# one bus is one that wins org.freedesktop.portal.Desktop and one that loses it,
# and the loser takes the session's portal down with it.
#
# Type=dbus with BusName= is what makes the ordering below mean anything. With
# Type=exec systemd considers the service started the moment it forks, so
# zenith-shell.service could be ordered after a process that has not yet decided
# which backends it implements. With Type=dbus, "started" means the name is on
# the bus — which is the moment the portal is genuinely usable.
[Unit]
Description=Zenith portal dispatcher
Documentation=https://github.com/mohitjoer/Zenith-OS
PartOf=graphical-session.target
After=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=org.freedesktop.portal.Desktop
ExecStart=/usr/libexec/xdg-desktop-portal
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hyprland-session.target
