[Desktop Entry]
Name=Zed
Comment=A high-performance, multiplayer code editor.
GenericName=Text Editor
Exec=zed %F
Icon=zed
Terminal=false
Type=Application
Categories=Utility;TextEditor;Development;IDE;
MimeType=text/plain;text/markdown;application/json;text/xml;application/xml;text/x-shellscript;application/x-shellscript;text/x-python;text/x-lua;text/css;text/html;text/x-csrc;text/x-chdr;text/x-c++src;text/x-go;application/toml;text/x-toml;application/x-yaml;text/yaml;
StartupNotify=true
StartupWMClass=dev.zed.Zed
