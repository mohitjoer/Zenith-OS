#!/bin/sh
# Asura user-level process supervisor for Void Linux / runit.
#
# Supervises: pipewire, wireplumber, xdg-desktop-portal-hyprland,
# xdg-desktop-portal, quickshell, asura-hubd, asura-wallpaper, swayidle.
#
# Usage:
#   asura-user-services start    # starts user runsvdir or spawns services
#   asura-user-services stop     # stops all user services
#   asura-user-services status   # queries status
set -eu

USER_SERVICE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/service"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/asura"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PID_FILE="$RUNTIME_DIR/asura-user-services.pid"

SYSTEM_SERVICES_SRC="/usr/share/asura/runit/services"
# Local fallback if testing in dev checkout
if [ ! -d "$SYSTEM_SERVICES_SRC" ]; then
	REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd 2>/dev/null || true)
	if [ -d "$REPO_ROOT/system/runit/user-services" ]; then
		SYSTEM_SERVICES_SRC="$REPO_ROOT/system/runit/user-services"
	fi
fi

seed_services() {
	mkdir -p "$USER_SERVICE_DIR"
	if [ -d "$SYSTEM_SERVICES_SRC" ]; then
		for svc_dir in "$SYSTEM_SERVICES_SRC"/*; do
			[ -d "$svc_dir" ] || continue
			svc_name=$(basename "$svc_dir")
			if [ ! -d "$USER_SERVICE_DIR/$svc_name" ]; then
				mkdir -p "$USER_SERVICE_DIR/$svc_name"
				cp -a "$svc_dir"/* "$USER_SERVICE_DIR/$svc_name/"
				chmod +x "$USER_SERVICE_DIR/$svc_name/run" 2>/dev/null || true
			fi
		done
	fi
}

start_services() {
	seed_services

	# Ensure WAYLAND_DISPLAY is resolved from socket if not already exported
	if [ -z "${WAYLAND_DISPLAY:-}" ]; then
		for sock in "$RUNTIME_DIR"/wayland-[0-9]*; do
			if [ -S "$sock" ]; then
				export WAYLAND_DISPLAY="$(basename "$sock")"
				break
			fi
		done
	fi

	# Ensure HYPRLAND_INSTANCE_SIGNATURE is resolved from socket dir if empty
	if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$RUNTIME_DIR/hypr" ]; then
		for sig_dir in $(ls -td "$RUNTIME_DIR"/hypr/*_* 2>/dev/null); do
			if [ -S "$sig_dir/.socket.sock" ]; then
				export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$sig_dir")"
				break
			fi
		done
	fi

	# Detect virtual machine graphics fallback for user desktop services
	if [ -z "${LIBGL_ALWAYS_SOFTWARE:-}" ]; then
		if [ -n "${ASURA_IS_VM:-}" ] || \
		   grep -qa "VirtualBox\|VMware\|QEMU\|KVM" /sys/class/dmi/id/product_name 2>/dev/null || \
		   grep -qa "VirtualBox\|VMware\|QEMU\|KVM\|innotek" /sys/class/dmi/id/sys_vendor 2>/dev/null || \
		   lspci 2>/dev/null | grep -qi "VMware\|VirtualBox\|QEMU"; then
			export LIBGL_ALWAYS_SOFTWARE=1
			export ASURA_IS_VM=1
		fi
	fi

	# Update D-Bus activation environment so activated tools know Wayland & runtime
	if command -v dbus-update-activation-environment >/dev/null 2>&1; then
		dbus-update-activation-environment --all 2>/dev/null || \
		dbus-update-activation-environment \
			XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP DESKTOP_SESSION \
			XDG_SESSION_TYPE WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_RUNTIME_DIR LIBGL_ALWAYS_SOFTWARE ASURA_IS_VM 2>/dev/null || true
	fi

	# Method 1: If runsvdir is available, run it over ~/.config/service
	if command -v runsvdir >/dev/null 2>&1; then
		echo "asura-user-services: starting runsvdir over $USER_SERVICE_DIR"
		runsvdir -P "$USER_SERVICE_DIR" &
		echo $! > "$PID_FILE"
		return 0
	fi

	# Method 2: Resilient background spawner fallback if runsvdir is not installed
	echo "asura-user-services: runsvdir not found; launching services directly"
	mkdir -p "$STATE_DIR"
	for svc in pipewire wireplumber portal-hyprland portal asurad quickshell asura-userd asura-hubd asura-wallpaper asura-idle; do
		run_script="$USER_SERVICE_DIR/$svc/run"
		if [ -x "$run_script" ]; then
			(
				while true; do
					"$run_script" >>"$STATE_DIR/$svc.log" 2>&1 || true
					sleep 1
				done
			) &
		fi
	done
}

stop_services() {
	if [ -f "$PID_FILE" ]; then
		pid=$(cat "$PID_FILE" 2>/dev/null || true)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill "$pid" 2>/dev/null || true
		fi
		rm -f "$PID_FILE"
	fi

	if command -v sv >/dev/null 2>&1 && [ -d "$USER_SERVICE_DIR" ]; then
		for s in "$USER_SERVICE_DIR"/*; do
			[ -d "$s" ] && sv down "$s" 2>/dev/null || true
		done
	fi

	pkill -u "$(id -u)" -x quickshell 2>/dev/null || true
	pkill -u "$(id -u)" -x asura-userd 2>/dev/null || true
	pkill -u "$(id -u)" -x asura-wallpaper 2>/dev/null || true
	pkill -u "$(id -u)" -x asura-hubd 2>/dev/null || true
	pkill -u "$(id -u)" -x xdg-desktop-portal-hyprland 2>/dev/null || true
	pkill -u "$(id -u)" -x xdg-desktop-portal 2>/dev/null || true
}

status_services() {
	if command -v sv >/dev/null 2>&1 && [ -d "$USER_SERVICE_DIR" ]; then
		for s in "$USER_SERVICE_DIR"/*; do
			[ -d "$s" ] || continue
			sv status "$s" || true
		done
	else
		echo "User services running under $(id -un):"
		pgrep -u "$(id -u)" -l -a -f 'quickshell|asura-|pipewire|wireplumber|xdg-desktop-portal' || echo "No active user desktop services found"
	fi
}

case "${1:-start}" in
	start)
		start_services
		;;
	stop)
		stop_services
		;;
	status)
		status_services
		;;
	*)
		echo "Usage: $0 {start|stop|status}" >&2
		exit 1
		;;
esac
