  "binds": [
    {
      "id": "launcher",
      "category": "desktop",
      "label": "Open the launcher",
      "chord": "SUPER + Space",
      "kind": "shell",
      "action": "togglePopover",
      "argument": "launcher"
    },
    {
      "id": "quick-settings",
      "category": "desktop",
      "label": "Open the quick settings",
      "chord": "SUPER + Escape",
      "kind": "shell",
      "action": "togglePopover",
      "argument": "quick"
    },
    {
      "id": "stash",
      "category": "desktop",
      "label": "Open the sidebar: screen time and downloads",
      "chord": "SUPER + S",
      "kind": "shell",
      "action": "toggleSurface",
      "argument": "stash"
    },
    {
      "id": "clipboard",
      "category": "desktop",
      "label": "Open the clipboard history",
      "chord": "SUPER + V",
      "kind": "shell",
      "action": "toggleSurface",
      "argument": "clipboard"
    },
    {
      "id": "cheatsheet",
      "category": "desktop",
      "label": "Show the keyboard shortcuts",
      "chord": "SUPER + K",
      "kind": "shell",
      "action": "toggleCheatsheet"
    },
    {
      "id": "lock",
      "category": "desktop",
      "label": "Lock the screen",
      "chord": "SUPER + L",
      "kind": "app",
      "action": "zenith-shell",
      "argument": "lock"
    },
    {
      "id": "settings",
      "category": "desktop",
      "label": "Open Zenith Settings",
      "chord": "SUPER + comma",
      "kind": "app",
      "action": "zenith-shell",
      "argument": "hub open"
    },
    {
      "id": "voice",
      "category": "desktop",
      "label": "Voice typing (press again to stop)",
      "chord": "SUPER + grave",
      "kind": "app",
      "action": "zenith-shell",
      "argument": "voice"
    },
    {
      "id": "wallpaper",
      "category": "desktop",
      "label": "Choose a wallpaper",
      "chord": "SUPER + W",
      "kind": "app",
      "action": "zenith-wallpaper",
      "argument": "wallpaper ui"
    },
    {
      "id": "wallpaper-random",
      "category": "desktop",
      "label": "Random wallpaper",
      "chord": "SUPER + SHIFT + W",
      "kind": "app",
      "action": "zenith-wallpaper",
      "argument": "wallpaper random"
    },
    {
      "id": "visualizer",
      "category": "desktop",
