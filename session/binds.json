      "category": "apps",
      "label": "Open a terminal",
      "chord": "SUPER + T",
      "kind": "app",
      "action": "zenith-app",
      "argument": "terminal",
      "also": [
        {
          "chord": "SUPER + Return"
        }
      ]
    },
    {
      "id": "files",
      "category": "apps",
      "label": "Open the file manager",
      "chord": "SUPER + E",
      "kind": "app",
      "action": "zenith-app",
      "argument": "files"
    },
    {
      "id": "browser",
      "category": "apps",
      "label": "Open the browser",
      "chord": "SUPER + B",
      "kind": "app",
      "action": "zenith-app",
      "argument": "browser"
    },
    {
      "id": "editor",
      "category": "apps",
      "label": "Open the editor",
      "chord": "SUPER + N",
      "kind": "app",
      "action": "zenith-app",
      "argument": "editor"
    },
    {
      "id": "notes",
      "category": "apps",
      "label": "Open the notes",
      "chord": "SUPER + O",
      "kind": "app",
      "action": "zenith-app",
      "argument": "notes"
    },
    {
      "id": "vm",
      "category": "apps",
      "label": "Open the virtual machine manager",
      "chord": "SUPER + SHIFT + V",
      "kind": "app",
      "action": "zenith-summon",
      "argument": "zenith-vm flock -n -o /tmp/zenith-vm.lock zenith-vm"
    },
    {
      "id": "close",
      "category": "windows",
      "label": "Close the window",
      "chord": "SUPER + Q",
      "kind": "wm",
      "action": "killactive"
    },
    {
      "id": "fullscreen",
      "category": "windows",
      "label": "Fullscreen the window",
      "chord": "SUPER + F",
      "kind": "wm",
      "action": "fullscreen",
      "argument": "0"
    },
    {
      "id": "maximise",
      "category": "windows",
      "label": "Maximise the window",
      "chord": "SUPER + D",
      "kind": "wm",
      "action": "fullscreen",
      "argument": "1"
    },
    {
      "id": "centre",
      "category": "windows",
      "label": "Centre the window",
      "chord": "SUPER + C",
      "kind": "wm",
      "action": "centerwindow"
    },
    {
      "id": "pin",
      "category": "windows",
      "label": "Pin the floating window to every workspace",
      "chord": "SUPER + SHIFT + P",
      "kind": "wm",
      "action": "pin"
    },
    {
      "id": "group",
      "category": "windows",
      "label": "Group the window into tabs",
      "chord": "SUPER + G",
      "kind": "wm",
      "action": "togglegroup"
    },
    {
      "id": "floating",
      "category": "windows",
      "label": "Float the window at 1000x660, or tile it back",
      "chord": "SUPER + A",
      "kind": "app",
      "action": "hyprctl",
      "argument": "--batch \"dispatch togglefloating ; dispatch resizeactive exact 1000 660 ; dispatch centerwindow\""
    },
    {
      "id": "resize-mode",
      "category": "windows",
      "label": "Resize mode: arrows or hjkl, Esc exits",
      "chord": "SUPER + R",
      "kind": "app",
      "action": "hyprctl",
      "argument": "dispatch submap resize && hyprctl notify -1 2200 0 \"Resize mode: arrows or hjkl resize. Esc exits\""
    },
    {
      "id": "focus",
      "category": "windows",
      "label": "Focus the window in that direction",
      "chord": "SUPER + Left",
      "kind": "wm",
      "action": "movefocus",
      "argument": "l",
      "also": [
        {
          "chord": "SUPER + Right",
          "argument": "r"
        },
        {
          "chord": "SUPER + Up",
          "argument": "u"
        },
        {
          "chord": "SUPER + Down",
          "argument": "d"
        }
      ]
    },
    {
      "id": "move",
      "category": "windows",
      "label": "Move the window in that direction",
      "chord": "SUPER + SHIFT + Left",
      "kind": "wm",
      "action": "movewindow",
      "argument": "l",
      "also": [
        {
          "chord": "SUPER + SHIFT + Right",
          "argument": "r"
        },
        {
          "chord": "SUPER + SHIFT + Up",
          "argument": "u"
        },
        {
          "chord": "SUPER + SHIFT + Down",
          "argument": "d"
        }
      ]
    },
    {
      "id": "resize",
      "category": "windows",
      "label": "Resize the window in that direction",
      "chord": "SUPER + CTRL + Left",
      "kind": "wm",
      "action": "resizeactive",
      "argument": "-40 0",
      "also": [
        {
          "chord": "SUPER + CTRL + Right",
          "argument": "40 0"
        },
        {
          "chord": "SUPER + CTRL + Up",
          "argument": "0 -40"
        },
        {
          "chord": "SUPER + CTRL + Down",
          "argument": "0 40"
        }
      ]
    },
    {
      "id": "merge",
      "category": "windows",
      "label": "Move the window into the group on that side",
      "chord": "SUPER + bracketleft",
      "kind": "wm",
      "action": "movewindoworgroup",
      "argument": "l",
      "also": [
        {
          "chord": "SUPER + bracketright",
          "argument": "r"
        }
      ]
    },
    {
      "id": "drag",
      "category": "windows",
      "label": "Drag the window",
      "chord": "SUPER + mouse:272",
      "kind": "wm",
      "action": "movewindow"
    },
    {
      "id": "drag-resize",
      "category": "windows",
      "label": "Resize the window by dragging",
      "chord": "SUPER + mouse:273",
      "kind": "wm",
      "action": "resizewindow"
    },
