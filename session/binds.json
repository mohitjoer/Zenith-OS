      "chord": "SUPER + M",
      "kind": "shell",
      "action": "toggleSurface",
      "argument": "visualizer"
    },
    {
      "id": "visualizer-overlay",
      "category": "desktop",
      "label": "Raise the visualiser over windows",
      "chord": "SUPER + SHIFT + M",
      "kind": "shell",
      "action": "toggleSurface",
      "argument": "visualizer-overlay"
    },
    {
      "id": "visualizer-place",
      "category": "desktop",
      "label": "Move the visualiser",
      "chord": "SUPER + ALT + M",
      "kind": "shell",
      "action": "toggleSurface",
      "argument": "visualizer-place"
    },
    {
      "id": "overview",
      "category": "desktop",
      "label": "Show every workspace and window",
      "chord": "SUPER + Tab",
      "kind": "shell",
      "action": "toggleOverview"
    },
    {
      "id": "overview-desktop",
      "category": "desktop",
      "label": "Step to the next desktop in the overview",
      "chord": "SUPER + ALT + Tab",
      "kind": "shell",
      "action": "overviewDesktop",
      "argument": "1"
    },
    {
      "id": "switcher",
      "category": "desktop",
      "label": "Switch to another window",
      "chord": "ALT + Tab",
      "kind": "shell",
      "action": "advanceSwitcher",
      "releaseAction": "closeSwitcher"
    },
    {
      "id": "switcher-reverse",
      "category": "desktop",
      "label": "Switch to the previous window",
      "chord": "ALT + SHIFT + Tab",
      "kind": "shell",
      "action": "reverseSwitcher",
      "releaseAction": "closeSwitcher"
    },
    {
