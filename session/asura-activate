#!/bin/sh
# Start the Asura session, once the compositor is up.
#
# Two things happen here, in this order, and the order is the point.
#
# The environment goes first. The units the session starts are started by the
# user manager, and a unit inherits the manager's environment rather than the
# shell's. The compositor knows which display it made and what that display
# is called; the manager does not, unless it is told. A unit that starts
# without the display in its environment believes it is on a machine with no
# screen, and the shell's condition on the display says exactly that and
# refuses to start.
#
# The target goes second, and only once the environment is right: starting it
# starts everything it wants (the portal dispatcher, the state daemon, the shell,
# the wallpaper engine, the idle clock), and the ones that draw check the display
# before they do anything.
#
# The compositor's configuration runs this once at start-up, which is the
# first moment the display exists. Nothing here waits for the display, because
# the thing that knows the display is the thing that runs this.
set -eu

# Update activation environment across D-Bus
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
	dbus-update-activation-environment --all 2>/dev/null || \
	dbus-update-activation-environment \
		XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP DESKTOP_SESSION \
		XDG_SESSION_TYPE WAYLAND_DISPLAY XDG_RUNTIME_DIR 2>/dev/null || true
fi

# Start user runit supervision
for cmd in /usr/share/asura/session/asura-user-services \
	/usr/bin/asura-user-services \
	"$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/runit/asura-user-services"; do
	if [ -x "$cmd" ]; then
		exec "$cmd" start
	fi
done
