#!/bin/sh
# Post-installation.
#
# The only thing worth doing here is telling the user the two commands that
# matter. An update tool that silently rewrites a user's configuration is the
# thing users are afraid of, and the answer to that fear is that they can see
# what it would do before it does it.
set -e

# ---------------------------------------------------------------- schemas
#
# GSettings cannot read a schema from its XML. It reads gschemas.compiled, which
# glib-compile-schemas produces by reading every .xml in the schema directory
# together — so it has to run after the file lands, and it has to run even when
# an unrelated schema changed.
#
# Skipping this is the quietest failure in the package: the schema is installed,
# the file is on disk, and `Settings { schemaId: "org.zenith.shell" }` fails at
# run time with "Settings schema 'org.zenith.shell' is not installed" while
# glib-compile-schemas sits right there saying the XML is fine.
if command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas /usr/share/glib-2.0/schemas || {
        echo "zenith: glib-compile-schemas failed; org.zenith.shell will not" >&2
        echo "zenith: be usable and every GSettings read of it will fall back" >&2
        echo "zenith: to a compiled-in default." >&2
        exit 1
    }
fi

# ------------------------------------------------------------------ units
#
# The user manager reads the unit files when it starts, and a package that
# replaces a unit file does not tell it. A manager that still has the old
# units keeps the old behaviour until something asks it to look again — and
# "something" was, until now, a logout.
#
# The symptom is a unit that says one thing on disk and another in the
# manager: a drop-in that is installed and ignored, a conflict that is
# declared and not applied. The install is the moment to reload, because the
# install is the moment the files changed.
#
# A manager that is not running is not an error: the units are read again
# when it next starts, which is the behaviour we want anyway.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
fi

case "$1" in
    configure)
        echo "zenith $2 installed."
        echo "  zenith doctor    — what differs between the base and your config"
        echo "  zenith status    — current revision and drift"
        echo "  zenith hardware report --profile — contribute this machine's profile"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

#DEBHELPER#

exit 0
