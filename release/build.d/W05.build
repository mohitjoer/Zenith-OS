# W05: the wallpaper daemon, the picker's launcher and the stage cut-out engine.
# The picker's QML (shell/wallpaper-ui.qml, shell/wallpaper-ui/) ships with the shell tree, and
# session/units/asura-wallpaper.service is picked up with the other units.
asura-wallpaper -> /usr/bin/asura-wallpaper
session/asura-wallpaper-ui -> /usr/bin/asura-wallpaper-ui
shell/scripts/asura-stage -> /usr/bin/asura-stage
