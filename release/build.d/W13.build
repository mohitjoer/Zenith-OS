# W13: the helper scripts the shell and the conf call by bare name. Each lands in /usr/bin because
# the shell runs under systemd --user, whose PATH does not contain ~/.local/bin. The collectors in
# shell/bin/ are not listed: the shell tree ships whole, and asura-ai-usage.service runs them
# from /usr/share/asura/shell/bin/.
shell/scripts/cliphist-thumbs.sh -> /usr/bin/cliphist-thumbs.sh
shell/scripts/localsend.sh -> /usr/bin/localsend.sh
shell/scripts/stash-cobalt-server.sh -> /usr/bin/stash-cobalt-server.sh
shell/scripts/stash-cobalt.sh -> /usr/bin/stash-cobalt.sh
shell/scripts/stash-compress.sh -> /usr/bin/stash-compress.sh
shell/scripts/stash-download.sh -> /usr/bin/stash-download.sh
shell/scripts/stash-install.sh -> /usr/bin/stash-install.sh
shell/scripts/asura-app -> /usr/bin/asura-app
shell/scripts/asura-cmd-caffeine -> /usr/bin/asura-cmd-caffeine
shell/scripts/asura-cmd-calc -> /usr/bin/asura-cmd-calc
shell/scripts/asura-cmd-color-picker -> /usr/bin/asura-cmd-color-picker
shell/scripts/asura-cmd-discord-compress -> /usr/bin/asura-cmd-discord-compress
shell/scripts/asura-cmd-edit-recording -> /usr/bin/asura-cmd-edit-recording
shell/scripts/asura-cmd-folders -> /usr/bin/asura-cmd-folders
shell/scripts/asura-cmd-game-mode -> /usr/bin/asura-cmd-game-mode
shell/scripts/asura-cmd-google-lens -> /usr/bin/asura-cmd-google-lens
shell/scripts/asura-cmd-ocr -> /usr/bin/asura-cmd-ocr
shell/scripts/asura-cmd-qr-scan -> /usr/bin/asura-cmd-qr-scan
shell/scripts/asura-cmd-radio -> /usr/bin/asura-cmd-radio
shell/scripts/asura-cmd-recording-saved -> /usr/bin/asura-cmd-recording-saved
shell/scripts/asura-cmd-screenrecord -> /usr/bin/asura-cmd-screenrecord
shell/scripts/asura-cmd-songrec -> /usr/bin/asura-cmd-songrec
shell/scripts/asura-cmd-studiorecord -> /usr/bin/asura-cmd-studiorecord
shell/scripts/asura-profile-stats -> /usr/bin/asura-profile-stats
shell/scripts/asura-summon -> /usr/bin/asura-summon
shell/scripts/asura-sysinfo -> /usr/bin/asura-sysinfo
# asura-ai-usage.service and .timer ship with the other units (every file in session/units/ does) and
# asura-session.target wants the timer, so there is no line for them here.
