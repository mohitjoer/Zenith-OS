pragma ComponentBehavior: Bound

// The colours the whole desktop is drawn in.
//
// Generated by `zenith theme generate` from one image, written to
// $XDG_CACHE_HOME/zenith/colors.json, and read here. The shell never derives a
// colour of its own: a surface that computed its own would be a second opinion
// about the palette, and two opinions is one more than a design system has.
//
// Every surface binds to these properties rather than naming a hex value. A
// hard-coded #202124 in a QML file is a colour that survives a theme change
// without being noticed, and it is the reason a themed desktop usually has two
// themes: the one you chose and the one the code has.

import Quickshell
import Quickshell.Io
import QtQuick

Singleton {
    id: palette

    // The fallback. Used when no palette has been generated, and it is a real
    // pair rather than a placeholder: a shell that falls back to black on black
    // is a shell with no desktop, and "I installed it and it is blank" is a much
    // worse report than "it is grey because you have not themed it".
    readonly property string background: "#15171a"
    readonly property string surface: "#1e2126"
    readonly property string text: "#e8eaed"
    readonly property string textDim: "#9aa0a6"
    readonly property string border: "#3c4043"
    readonly property string accent: "#4c8bf5"
    readonly property string onAccent: "#ffffff"

    // Whether a generated palette was actually found. The shell shows this
    // nowhere on purpose: it is a diagnostic, and `zenith theme check` is where a
    // user asks about it.
    readonly property bool generated: false

    readonly property string path: palette.cacheDir + "/zenith/colors.json"

    readonly property string cacheDir: {
        var dir = Quickshell.env("XDG_CACHE_HOME")
        if (dir !== "") return dir
        return Quickshell.env("HOME") + "/.cache"
    }

    // Loaded once at startup rather than watched.
    //
    // A watched palette would repaint the desktop mid-transition every time the
    // user changed a wallpaper, and the repaint is the point rather than an
    // accident — so it happens on a deliberate action, and `zenith theme
    // generate` tells the shell to reload when it is ready to.
    Process {
        id: cat
        command: ["cat", palette.path]
        running: palette.loadToken !== ""

        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    palette.apply(JSON.parse(text))
                } catch (error) {
                    // A broken palette leaves the fallback in place rather than
                    // throwing, because a shell that dies on a parse error is a
                    // shell with no desktop at all.
                }
            }
        }
    }

    property string loadToken: ""

    function reload() {
        loadToken = Date.now()
    }

    function apply(document) {
        palette.background = document.background
        palette.surface = document.surface
        palette.text = document.text
        palette.text_dim = document.text_dim
        palette.border = document.border
        palette.accent = document.accent
        palette.on_accent = document.on_accent
        generated = true
    }

    Component.onCompleted: reload()
}
