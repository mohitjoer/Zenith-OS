pragma Singleton
pragma ComponentBehavior: Bound

// The colours the whole desktop is drawn in.
//
// Generated by `zenith theme generate` from one image, written to
// $XDG_CACHE_HOME/zenith/colors.json, and read here. The shell never derives a
// colour of its own: a surface that computed its own would be a second opinion
// about the palette, and two opinions is one more than a design system has.
//
// Every surface binds to these properties rather than naming a hex value. A
// hard-coded #202124 in a QML file is a colour that survives a theme change
// without being noticed, and it is the reason a themed desktop usually has two
// themes: the one you chose and the one the code has.

import Quickshell
import Quickshell.Io
import QtQuick

Singleton {
    id: palette

    // The fallback. Used when no palette has been generated, and it is a real
    // pair rather than a placeholder: a shell that falls back to black on black
    // is a shell with no desktop, and "I installed it and it is blank" is a much
    // worse report than "it is grey because you have not themed it".
    //
    // These are writable rather than readonly because apply() writes them, and
    // they were readonly — which meant the first assignment threw, the function
    // stopped there, and a generated palette was never applied to a running
    // shell. `zenith theme generate` wrote a file nothing could use. apply() is
    // the only writer; a surface binding to one of these still only reads it.
    //
    // Colours, not strings. The tokens below are derived from these by
    // reading their channels, and a string has no channels: a token derived
    // from a string is a token derived from nothing, which is how a hairline
    // that was meant to be ink at a tenth became black at a tenth and was
    // invisible on a dark wallpaper.
    property color background: "#15171a"
    property color surface: "#1e2126"
    property color text: "#e8eaed"
    property color textDim: "#9aa0a6"
    property color border: "#3c4043"
    property color accent: "#4c8bf5"
    property color accentForeground: "#ffffff"

    // ---------------------------------------------------------------- surfaces
    //
    // The measurements every raised surface in the shell shares.
    //
    // They live here rather than in each file because the bar, the dock, the
    // launcher and the sidebar are one design, and a design whose parts each
    // have their own idea of a radius and a gap is four designs that happen to
    // be on the same screen.
    //
    // The spacing is the project's 4px grid, the radii are its radius scale,
    // and the two hairline weights are the only border weights the shell has:
    // a border that separates a surface from its neighbour, and a border that
    // separates a surface from the wallpaper.
    readonly property int radiusSmall: 6
    readonly property int radiusMedium: 8
    readonly property int radiusLarge: 12

    readonly property int space1: 4
    readonly property int space2: 8
    readonly property int space3: 12
    readonly property int space4: 16
    readonly property int space5: 24

    // A border that separates a surface from what is behind it. One pixel,
    // and the colour is the ink at a tenth, so it reads on any wallpaper
    // without being a line.
    readonly property int hairlineWidth: 1
    readonly property color hairline: Qt.rgba(text.r, text.g, text.b, 0.12)

    // The state layer a hovered control carries. Eight percent of the ink:
    // enough to see, not enough to be a second colour.
    readonly property color stateLayer: Qt.rgba(text.r, text.g, text.b, 0.08)

    // The fill a raised surface carries over the wallpaper. A surface that is
    // opaque is a surface that hides the picture; a surface that is glass has
    // to say so with a border instead.
    readonly property color panelFill: Qt.rgba(surface.r, surface.g, surface.b, 0.86)

    // The ambient shadow. One shadow, one recipe, always thrown away from the
    // screen edge so it falls on the desktop and never on the neighbour.
    readonly property int shadowBlur: 12
    readonly property int shadowOffset: 2
    readonly property color shadow: Qt.rgba(0, 0, 0, 0.5)

    // Whether a generated palette was actually found. The shell shows this
    // nowhere on purpose: it is a diagnostic, and `zenith theme check` is where a
    // user asks about it.
    property bool generated: false

    readonly property string path: palette.cacheDir + "/zenith/colors.json"

    readonly property string cacheDir: {
        var dir = Quickshell.env("XDG_CACHE_HOME")
        if (dir !== "") return dir
        return Quickshell.env("HOME") + "/.cache"
    }

    // The palette, as the file has it.
    //
    // It is read by the shell's root and pushed in here, for the reason the
    // settings are: a process inside a singleton is a process that never runs,
    // and a shell that cannot read its own palette is a shell whose colours
    // are the ones it shipped with.
    //
    // A watched palette would repaint the desktop mid-transition every time
    // the user changed a wallpaper, and the repaint is the point rather than an
    // accident — so it happens on a deliberate action, and `zenith theme
    // generate` tells the shell to reload when it is ready to.
    property var palette: ({})
    property string loadToken: ""

    onPaletteChanged: {
        if (palette && Object.keys(palette).length > 0) {
            apply(palette);
        }
    }

    function reload() {
        loadToken = Date.now();
    }

    function apply(document) {
        palette.background = document.background
        palette.surface = document.surface
        palette.text = document.text
        palette.textDim = document.text_dim
        palette.border = document.border
        palette.accent = document.accent
        palette.accentForeground = document.on_accent
        generated = true
    }

    Component.onCompleted: reload()
}
