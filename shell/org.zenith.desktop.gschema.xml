<?xml version="1.0" encoding="UTF-8"?>
<!--
  org.zenith.desktop — desktop-level behaviour.

  Separate from org.zenith.shell because the shell is a consumer of these
  decisions, not their owner. The colour scheme belongs to the desktop: the hub
  writes it, the shell reads it, and if the shell owned a copy it would be a
  second decision that could disagree with the first.

  Adoption imports `color-scheme` here from org.gnome.desktop.interface, so that
  key's name and type are a contract with docs/adopting-zenith.md.
-->
<schemalist>

  <enum id="org.zenith.desktop.ColorScheme">
    <value nick="default" value="0"/>
    <value nick="prefer-dark" value="1"/>
    <value nick="prefer-light" value="2"/>
  </enum>

  <schema id="org.zenith.desktop" path="/org/zenith/desktop/">

    <key name="color-scheme" enum="org.zenith.desktop.ColorScheme">
      <default>'default'</default>
      <summary>Whether the desktop prefers light or dark</summary>
      <description>
        Imported by adoption from org.gnome.desktop.interface. The shell reads
        this and does not write it.
      </description>
    </key>


    <!-- =========================================================== idle policy
         These live here rather than in org.zenith.shell because they are
         desktop behaviour, not layout: the shell and the Hub both change them,
         and neither of them owns the other's schema.

         Timeouts are seconds, and 0 means never rather than immediately. A
         timeout of 0 that means "lock now" is a key whose default value locks
         the machine the moment it is installed, and every "0 means never" key
         in a desktop has existed because somebody got that backwards. -->

    <key name="idle-dim-seconds" type="i">
      <default>0</default>
      <range min="0" max="3600"/>
      <summary>Seconds of inactivity before the screen dims</summary>
      <description>0 means the screen never dims.</description>
    </key>

    <key name="idle-blank-seconds" type="i">
      <default>0</default>
      <range min="0" max="3600"/>
      <summary>Seconds of inactivity before the screen blanks</summary>
      <description>0 means the screen never blanks.</description>
    </key>

    <key name="idle-lock-seconds" type="i">
      <default>300</default>
      <range min="0" max="86400"/>
      <summary>Seconds of inactivity before the session locks</summary>
      <description>
        0 means never. The default is five minutes because a session that is
        unattended for a long time and is not locked is a session anyone walking
        past can use.
      </description>
    </key>


  </schema>

</schemalist>
