#!/usr/bin/env bash
# 天 game mode = one reversible toggle. competitive-play tune on start, back
# to normal on stop. the compositor via hyprctl (no root). the system knobs
# that need root go through zenith-game-tune and the wifi radio through
# zenith-wifi-powersave, both pre-authorised by polkit so the toggle stays one
# click. dnd is the shell's job (Flags.dnd) and bridges in here, same as
# zenith-cmd-caffeine.
#
#   status   exit 0 = on
#   start    apply, persist (idempotent, safe to re-run)
#   stop     restore, clear
#   toggle
#
# revert = exact. compositor changes are runtime overrides hyprctl applies; a
# reload rereads the config and clears them, so nothing to track. the wifi helper
# saves + restores the prior power-save state, zenith-game-tune saves + restores
# every knob it touches, and the prior power profile is written down here.
# `start` is safe to re-run after a relogin (the compositor comes back fresh,
# request is still on disk).
#
# AC only, on purpose. every lever here trades power and heat for latency, and
# on battery that is a bad deal the user cannot see: deep idle states off and a
# performance governor drain a pack fast and push a thermally-governed chip
# straight to its ceiling. so `start` refuses while discharging and says why,
# rather than quietly delivering a worse machine. no battery, or one that cannot
# be read, reads as AC, so an odd machine is permitted rather than locked out.
set -u

state_dir="${ZENITH_STATE_PATH:-${XDG_STATE_HOME:-$HOME/.local/state}/zenith}"
state_file="${ZENITH_GAMEMODE_STATE_FILE:-$state_dir/game-mode.enabled}"
profile_file="${ZENITH_GAMEMODE_PROFILE_FILE:-$state_dir/game-mode.profile}"

# Helpers are resolved once, through an explicit seam. `command -v` alone would
# find a deployed copy in /usr/bin even when a caller means "pretend this is
# absent", which is exactly the case a test needs to cover.
wifi_helper="${ZENITH_WIFI_POWERSAVE_BIN-$(command -v zenith-wifi-powersave || true)}"
tune_helper="${ZENITH_GAME_TUNE_BIN-$(command -v zenith-game-tune || true)}"

stripped=0

is_on() { [[ -f $state_file ]]; }

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send -a Zenith "$1" "$2" || true
}

# ── power source ──────────────────────────────────────────────────────────────
# Discharging only when a battery says so. ZENITH_POWER_SYSFS is the test seam.
on_battery() {
  local b
  for b in "${ZENITH_POWER_SYSFS:-/sys/class/power_supply}"/BAT*/status; do
    [[ -r $b && $(<"$b") == Discharging ]] && return 0
  done
  return 1
}

# ── compositor ────────────────────────────────────────────────────────────────
# The decoration strip is a set of runtime overrides: it kills present-time cost
# (blur, shadow, rounding, opacity blending, animations) and flips to a
# low-latency path with immediate tearing and fullscreen-only VRR. render_unfocused
# on fullscreen windows keeps a game on another workspace scheduled instead of
# stalling on the frame callbacks an invisible surface never gets (its audio would
# keep playing, input would die, and multiplayer would time out). Off reloads the
# config, which rereads it and drops every override.
deco_strip() {
  local out
  command -v hyprctl >/dev/null 2>&1 || return 0
  out="$(hyprctl --batch "keyword general:allow_tearing true ; keyword decoration:rounding 0 ; keyword decoration:active_opacity 1 ; keyword decoration:inactive_opacity 1 ; keyword decoration:blur:enabled false ; keyword decoration:shadow:enabled false ; keyword animations:enabled false ; keyword misc:vrr 2 ; keyword windowrule immediate on, match:class .* ; keyword windowrule render_unfocused on, match:fullscreen 1" 2>&1)" || return 0
  [[ -z $(grep -v '^ok$' <<<"$out") ]] && stripped=1
  return 0
}

deco_restore() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl reload >/dev/null 2>&1 || true
}

# ── cpu ───────────────────────────────────────────────────────────────────────
# power-profiles-daemon owns the governor, EPP and platform_profile as a set, so
# asking it for `performance` is the whole CPU story and needs no root: the
# session's own D-Bus call is already authorised. Doing it here rather than in
# zenith-game-tune keeps the privileged helper to knobs that genuinely need
# privilege.
#
# The prior profile is written down before switching so `stop` can put back what
# the user actually had, not a guess at "balanced".
profile_fast() {
  command -v powerprofilesctl >/dev/null 2>&1 || return 0
  local prior
  prior="$(powerprofilesctl get 2>/dev/null)" || return 0
  [[ -n $prior ]] || return 0
  printf '%s\n' "$prior" >"$profile_file" 2>/dev/null || true
  powerprofilesctl set performance >/dev/null 2>&1 || true
}

profile_restore() {
  command -v powerprofilesctl >/dev/null 2>&1 || return 0
  local prior
  prior="$(cat "$profile_file" 2>/dev/null)" || return 0
  rm -f "$profile_file" 2>/dev/null || true
  [[ -n $prior ]] || return 0
  powerprofilesctl set "$prior" >/dev/null 2>&1 || true
}

# ── system knobs (root, via polkit) ───────────────────────────────────────────
# Deep idle states, the NMI watchdog, split/bus-lock mitigation and three VM
# knobs. The helper saves every prior value and restores it exactly; see
# system/hardware/power/zenith-game-tune for why each one is there and why the
# firmware-governed knobs are not.
tune() {  # apply | restore
  [[ -n $tune_helper && -x $tune_helper ]] || return 0
  "$tune_helper" "$1" >/dev/null 2>&1 || true
}

# ── wifi (latency only, never a cap) ──────────────────────────────────────────
# 802.11 power-save off = radio stays fully awake. kills the periodic
# micro-sleeps that spike latency on an idle link. does NOT shape, cap, or
# drop the link, so throughput is untouched. the privileged helper does it
# via iw with no reconnect and saves + restores the prior state. no wifi or
# no helper = no-op.
has_wifi() {
  local w
  for w in "${ZENITH_NET_SYSFS:-/sys/class/net}"/*/wireless; do [[ -e $w ]] && return 0; done
  return 1
}

wifi_set() {  # off | on
  [[ -n $wifi_helper && -x $wifi_helper ]] || return 0
  has_wifi || return 0
  pkexec "$wifi_helper" "$1" >/dev/null 2>&1 || true
}

start() {
  # Refuse while discharging. Checked before anything is applied, so a refusal
  # leaves the machine exactly as it was and the request unpersisted.
  if on_battery; then
    notify "天 Game Mode" "Needs AC - every lever here trades battery and heat for latency"
    return 1
  fi

  mkdir -p "$state_dir" 2>/dev/null || true
  deco_strip
  profile_fast
  tune apply
  wifi_set off
  printf 'enabled\n' >"$state_file" 2>/dev/null || true
  if (( stripped )); then
    notify "天 Game Mode" "On - performance profile, deep idle off, compositor stripped"
  else
    notify "天 Game Mode" "On - performance profile, deep idle off"
  fi
}

stop() {
  deco_restore
  tune restore
  profile_restore
  wifi_set on
  rm -f "$state_file" 2>/dev/null || true
  notify "天 Game Mode" "Off - desktop restored"
}

case "${1:-toggle}" in
  status)     is_on ;;
  on | start) start ;;
  off | stop) stop ;;
  toggle)     if is_on; then stop; else start; fi ;;
  *)
    echo "usage: zenith-cmd-game-mode [status | start | stop | toggle]" >&2
    exit 1
    ;;
esac
