#!/usr/bin/env bash
# region -> QR. grim+slurp grab, zbarimg decodes, wl-copy stores, URLs get
# xdg-open. --file IMAGE skips the grab.
set -euo pipefail

app="QR Code"
prog="zenith-cmd-qr-scan"
# A missing tool is a notification, because the shell runs this with nowhere to
# print, plus exit 127 (the shell's "command not found") with the apt package
# named. notify-send is checked first and on its own: it is the one tool whose
# absence cannot be reported through itself.
need() { # command [package]
  command -v "$1" >/dev/null 2>&1 && return 0
  echo "$prog: $1 is not installed (sudo apt install ${2:-$1})" >&2
  command -v notify-send >/dev/null 2>&1 \
    && notify-send -u normal "$app" "$1 is not installed (sudo apt install ${2:-$1})" 2>/dev/null
  exit 127
}

need notify-send libnotify-bin

input_file=""
if [[ ${1:-} == "--file" ]]; then
  [[ -n ${2:-} ]] || { notify-send -u critical "$app" "Missing image path"; exit 2; }
  input_file="$2"; shift 2
fi
(( $# == 0 )) || { notify-send -u critical "$app" "Usage: $prog [--file IMAGE]"; exit 2; }

need zbarimg zbar-tools
need wl-copy wl-clipboard
need xdg-open xdg-utils

# Only the file made here is removed; a --file image is the caller's.
shot=""
cleanup() { [[ -z $shot ]] || rm -f "$shot"; }
trap cleanup EXIT

tmp="$input_file"
if [[ -z $tmp ]]; then
  need grim
  need slurp
  shot="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/zenith-qr.XXXXXX.png")"
  tmp="$shot"
fi

if [[ -n $input_file ]]; then
  [[ -r $tmp ]] || { notify-send -u critical "$app" "Cannot read image at $tmp"; exit 1; }
else
  # slurp nonzero = Esc/cancel. bail quietly.
  geometry="$(slurp 2>/dev/null)" || exit 130
  [[ -n $geometry ]] || exit 0
  grim -g "$geometry" "$tmp"
fi

result="$(zbarimg --raw "$tmp" 2>/dev/null | head -n 1 || true)"
if [[ -z $result ]]; then
  notify-send -u normal "$app" "No QR code found in the selected area"
  exit 0
fi

printf '%s' "$result" | wl-copy
case "$result" in
  http://*|https://*)
    xdg-open "$result" >/dev/null 2>&1 || true
    notify-send -u low "$app" "Opened $result"
    ;;
  *)
    notify-send -u low "$app" "Copied to clipboard"
    ;;
esac
