#!/usr/bin/env bash
# hyprpicker -> hex -> clipboard. --repeat keeps the loop alive until cancel.
set -euo pipefail

app="Color picker"
prog="zenith-cmd-color-picker"
# A missing tool is a notification, because the shell runs this with nowhere to
# print, plus exit 127 (the shell's "command not found") with the apt package
# named. notify-send is checked first and on its own: it is the one tool whose
# absence cannot be reported through itself.
need() { # command [package]
  command -v "$1" >/dev/null 2>&1 && return 0
  echo "$prog: $1 is not installed (sudo apt install ${2:-$1})" >&2
  command -v notify-send >/dev/null 2>&1 \
    && notify-send -u normal "$app" "$1 is not installed (sudo apt install ${2:-$1})" 2>/dev/null
  exit 127
}

repeat=false
case "${1:-}" in
  "") ;;
  --repeat) repeat=true ;;
  *) notify-send -u critical "$app" "Usage: $prog [--repeat]"; exit 2 ;;
esac

need notify-send libnotify-bin
need hyprpicker
need wl-copy wl-clipboard

while true; do
  if ! color="$(hyprpicker -f hex)"; then
    [[ $repeat == true ]] && exit 0
    exit 130
  fi
  if [[ -n $color ]]; then
    # wl-copy forks + holds the selection. hyprpicker -a alone dies the moment
    # hyprpicker exits if nothing else owns the clipboard.
    printf '%s' "$color" | wl-copy
    printf '%s\n' "$color"
    notify-send -u low "$app" "Copied $color"
  fi
  [[ $repeat == true ]] || break
done
