#!/usr/bin/env bash
# sysread for the pill's SYSTEM card. one field per line, exact order SysInfo.qml
# parses. dual-GPU aware: matches device classes (not bus ids), strips the
# bus/class prefix and vendor noise. first run rolls a random codename and saves
# it to ~/.local/state/zenith/codename, so the operator handle stays stable
# across reboots for this install.
export LC_ALL=C

clean_gpu() {
    sed -E 's/^[^ ]+ [^:]*: //; s/ \(rev [0-9a-f]+\)//; s/NVIDIA Corporation //; s/Advanced Micro Devices, Inc\. //; s/Intel Corporation //; s/\[AMD\/ATI\] //; s/.*\[([^]]+)\].*/\1/' | xargs | cut -c1-30
}

gpus=$(lspci 2>/dev/null | grep -iE 'vga compatible|3d controller|display controller')
gpu1=$(printf '%s\n' "$gpus" | sed -n '1p' | clean_gpu)
gpu2=$(printf '%s\n' "$gpus" | sed -n '2p' | clean_gpu)

cf="${XDG_STATE_HOME:-$HOME/.local/state}/zenith/codename"
if [ ! -s "$cf" ]; then
    mkdir -p "$(dirname "$cf")"
    names=(VESPER ONYX KESTREL CIPHER NOVA EMBER RONIN ZENITH OBSIDIAN HALCYON \
           VANTA KAIROS AZRAEL SABLE FENRIR ORACLE PHANTOM VECTOR RIFT ECHO \
           FLUX NEXUS QUASAR PULSAR COBALT SPECTRE VORTEX ZEPHYR AXIOM BASTION \
           DRIFT ETHER GLITCH HAVOC IGNIS KARMA LUMEN MIRAGE NOCTIS OMEN \
           PRISM QUILL RAVEN SOLACE TEMPEST UMBRA VIGIL WRAITH XENON ZEALOT \
           BLAZE CRUX DUSK FORGE GRIM HELIX ION JADE LYNX MAZE \
           NOMAD ODIN PYRE QUARTZ RUNE STYX TALON VOID WARP ZERO \
           ARGON BOREAL CINDER DELTA FABLE GOSSAMER HOLLOW INDIGO JUNO KITE)
    printf '%s\n' "${names[$((RANDOM % ${#names[@]}))]}" > "$cf"
fi
codename=$(cat "$cf")

# Focused display geometry from Hyprland's own monitor list. When hyprctl or jq
# cannot answer (no compositor, or a process started outside the session) the
# kernel's DRM state still names the current mode's resolution, so the field
# never blanks; refresh has no neutral file source and stays empty there.
disp_res=""
disp_hz=""
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    read -r disp_res disp_hz < <(
        hyprctl monitors -j 2>/dev/null | jq -r '
            ((first(.[] | select(.focused)) // .[0]) // {})
            | [ (if (.width // 0) > 0 then "\(.width)x\(.height)" else "" end),
                (if (.refreshRate // 0) > 0 then "\(.refreshRate | round)Hz" else "" end) ]
            | @tsv' 2>/dev/null
    ) || true
fi
if [ -z "$disp_res" ]; then
    for m in /sys/class/drm/card*-*/modes; do
        c="${m%/modes}"
        [ "$(cat "$c/enabled" 2>/dev/null)" = enabled ] || continue
        IFS= read -r disp_res < "$m" 2>/dev/null || disp_res=""
        [ -n "$disp_res" ] && break
    done
fi

# Installed packages, the dpkg way: only entries whose status is "ii" count, so
# a removed-but-configured package (rc) does not inflate the figure.
pkgs=$(dpkg-query -W -f='${db:Status-Abbrev}\n' 2>/dev/null | grep -c '^ii')

whoami
cat /etc/hostname 2>/dev/null || hostname
grep -m1 'PRETTY_NAME' /etc/os-release 2>/dev/null | cut -d'"' -f2
uname -m
uname -r
echo "${SHELL##*/}"
grep -m1 'model name' /proc/cpuinfo | sed 's/.*: //; s/ *@ .*//; s/([^)]*)//g; s/ w\/.*//; s/ with .*//; s/^[0-9]*[a-z]* Gen //; s/^Intel //; s/ CPU$//' | xargs | cut -c1-26
echo "$(nproc)C / $(nproc --all)T"
echo "${gpu1:--}"
echo "$gpu2"
free -h --si | awk '/Mem:/{print $3" / "$2}'
free | awk '/Mem:/{print int($3/$2*100)}'
df -h / | awk 'NR==2{print $3" / "$2}'
df / | awk 'NR==2{print int($3/($3+$4)*100)}'
awk '{h=int($1/3600); m=int(($1%3600)/60); print h"h "m"m"}' /proc/uptime
printf '%s\n' "${pkgs:-0}"
printf '%s\n' "$disp_res"
printf '%s\n' "$disp_hz"
echo "$codename"
