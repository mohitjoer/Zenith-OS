# Template file for 'zenith'
pkgname=zenith
version=0.1
revision=1
build_style=go
go_import_path="zenith/desktop"
go_package="zenith/desktop/cmd/zenith zenith/desktop/cmd/zenith-sysd zenith/desktop/cmd/zenith-userd zenith/desktop/cmd/zenith-hubd zenith/desktop/cmd/zenith-shell zenith/desktop/cmd/zenith-wallpaper zenith/desktop/cmd/zpm"
hostmakedepends="go"
depends="hyprland quickshell seatd turnstile ghostty papirus-icon-theme font-awesome"
short_desc="Zenith OS control plane, session daemons, and system integration"
maintainer="Zenith OS Project <dev@zenithos.dev>"
license="MIT"
homepage="https://zenithos.dev"

post_install() {
	vlicense LICENSE
	# Install session scripts and Wayland desktop entry
	vinstall session/zenith-session 755 usr/share/zenith/session
	vinstall session/zenith-activate 755 usr/share/zenith/session
	vinstall session/runit/zenith-user-services 755 usr/bin
	vinstall system/helpers/prime-run 755 usr/bin
	vinstall session/zenith.desktop 644 usr/share/wayland-sessions

	# Install runit service templates
	vmkdir usr/share/zenith/runit/services
	vcopy "system/runit/user-services/*" usr/share/zenith/runit/services

	# Install system runit service (zenith-sysd)
	vsv zenith-sysd

	# Install udev power rules
	vinstall system/udev/99-zenith-power.rules 644 usr/lib/udev/rules.d
}
