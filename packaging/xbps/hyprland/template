# Template file for 'hyprland'
pkgname=hyprland
version=0.53.3
revision=1
build_style=meson
configure_args="-Ddefault_library=shared -Dsystemd=disabled"
hostmakedepends="pkg-config wayland-devel hyprwayland-scanner jq glslang"
makedepends="wayland-protocols wayland-devel cairo-devel pango-devel
 libxkbcommon-devel libinput-devel pixman-devel libdrm-devel
 hyprlang-devel hyprutils-devel hyprcursor-devel aquamarine-devel
 tomlplusplus"
short_desc="Dynamic tiling Wayland compositor that doesn't sacrifice on its looks"
maintainer="Zenith OS Project <dev@zenithos.dev>"
license="BSD-3-Clause"
homepage="https://hyprland.org"
distfiles="https://github.com/hyprwm/Hyprland/releases/download/v${version}/source-v${version}.tar.gz"

post_install() {
	vlicense LICENSE
	vinstall example/hyprland.desktop 644 usr/share/wayland-sessions
}
