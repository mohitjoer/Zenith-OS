# Zenith OS Low-Latency Gaming & Compilation Kernel Configuration
# Designed for maximum 1% low gaming framerates and sub-millisecond desktop response

CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT=y
CONFIG_USER_NS=y

# Disable heavy debug info to keep compilation under 15 minutes
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=y
