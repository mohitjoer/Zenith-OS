[Plymouth Theme]
Name=Zenith
Description=Zenith OS Monochrome Boot Splash with Logo and Progress Bar Animation
ModuleName=script
Font=DejaVu Sans 10
TitleFont=DejaVu Sans Bold 10
MonospaceFont=DejaVu Sans Mono 10

[script]
ImageDir=/usr/share/plymouth/themes/zenith
ScriptFile=/usr/share/plymouth/themes/zenith/zenith.script
