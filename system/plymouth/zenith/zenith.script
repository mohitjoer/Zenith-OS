# Zenith OS Plymouth Boot Splash Script
# Monochrome theme featuring a centered logo and animated progress bar.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# Logo at center
logo_img = Image("logo.png");
logo_sprite = Sprite(logo_img);
logo_w = logo_img.GetWidth();
logo_h = logo_img.GetHeight();
logo_x = screen_w / 2 - logo_w / 2;
logo_y = screen_h / 2 - 90;
logo_sprite.SetPosition(logo_x, logo_y, 10);
logo_sprite.SetOpacity(1);

# Progress Bar below centered logo
bar_box_img = Image("progress_box.png");
bar_box_sprite = Sprite(bar_box_img);
bar_box_w = bar_box_img.GetWidth();
bar_box_h = bar_box_img.GetHeight();
bar_box_x = screen_w / 2 - bar_box_w / 2;
bar_box_y = logo_y + logo_h + 32;
bar_box_sprite.SetPosition(bar_box_x, bar_box_y, 8);
bar_box_sprite.SetOpacity(1);

bar_fg_original = Image("progress_bar.png");
bar_fg_sprite = Sprite();
bar_fg_sprite.SetPosition(bar_box_x + 2, bar_box_y + 2, 9);
bar_fg_sprite.SetOpacity(1);

percent_sprite = Sprite();
pct_y = bar_box_y + bar_box_h + 16;
percent_sprite.SetPosition(screen_w / 2 - 50, pct_y, 10);
percent_sprite.SetOpacity(1);

current_progress = 0.05;
boot_ticks = 0;

fun update_progress_ui() {
    percent = Math.Int(current_progress * 100);
    if (percent > 100) percent = 100;
    if (percent < 5) percent = 5;
    
    max_bar_w = bar_box_w - 4;
    target_w = Math.Int(max_bar_w * current_progress);
    if (target_w < 1) target_w = 1;
    if (target_w > max_bar_w) target_w = max_bar_w;
    
    bar_img = bar_fg_original.Scale(target_w, bar_fg_original.GetHeight());
    bar_fg_sprite.SetImage(bar_img);
    bar_fg_sprite.SetOpacity(1);
    
    pct_img = Image.Text(percent + "% COMPLETED", 1.0, 1.0, 1.0, 1.0, "DejaVu Sans Bold 10", "center");
    if (!pct_img) {
        pct_img = Image.Text(percent + "% COMPLETED", 1.0, 1.0, 1.0, 1.0, "Sans Bold 10", "center");
    }
    if (!pct_img) {
        pct_img = Image.Text(percent + "% COMPLETED", 1.0, 1.0, 1.0, 1.0);
    }
    if (pct_img) {
        percent_sprite.SetImage(pct_img);
        percent_sprite.SetPosition(screen_w / 2 - pct_img.GetWidth() / 2, pct_y, 10);
        percent_sprite.SetOpacity(1);
    }
}

fun display_normal_callback() {
    logo_sprite.SetOpacity(1);
    bar_box_sprite.SetOpacity(1);
    bar_fg_sprite.SetOpacity(1);
    percent_sprite.SetOpacity(1);
    update_progress_ui();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun progress_callback(duration, progress) {
    if (progress > current_progress) {
        current_progress = progress;
        update_progress_ui();
    } else if (duration > 0) {
        estimated = duration / 7.0;
        if (estimated > 0.98) estimated = 0.98;
        if (estimated > current_progress) {
            current_progress = estimated;
            update_progress_ui();
        }
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

# Continuous frame refresh callback (invoked ~50 FPS by Plymouth script engine)
fun refresh_callback() {
    boot_ticks++;
    
    # Smooth progression over ~8 seconds (400 ticks at 50fps)
    simulated = boot_ticks / 400.0;
    if (simulated > 1.0) simulated = 1.0;
    if (simulated > current_progress) {
        current_progress = simulated;
        update_progress_ui();
    }

    # Safe fallback: if boot has progressed past 11 seconds (~550 ticks), auto-fade
    # all sprites to ensure console, DRM master, and Wayland desktop are never obscured
    if (boot_ticks > 550) {
        quit_callback();
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun status_callback(status) {
    # Status updates intentionally silent to maintain clean animated splash
}
Plymouth.SetUpdateStatusFunction(status_callback);

fun message_callback(msg) {
    # Messages intentionally silent to maintain clean animated splash
}
Plymouth.SetDisplayMessageFunction(message_callback);

fun quit_callback() {
    logo_sprite.SetOpacity(0);
    bar_box_sprite.SetOpacity(0);
    bar_fg_sprite.SetOpacity(0);
    percent_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);

# Trigger initial display
display_normal_callback();
