#!/bin/sh
exec 2>&1
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$RUNTIME_DIR"
if [ -S "$RUNTIME_DIR/bus" ]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME_DIR/bus"
fi
EXE=""
for p in /usr/libexec/xdg-desktop-portal-hyprland /usr/lib/xdg-desktop-portal-hyprland; do
	if [ -x "$p" ]; then
		EXE="$p"
		break
	fi
done
if [ -z "$EXE" ]; then
	echo "xdg-desktop-portal-hyprland not found" >&2
	exit 1
fi
exec "$EXE"
