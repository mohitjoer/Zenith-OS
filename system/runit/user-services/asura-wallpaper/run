#!/bin/sh
exec 2>&1

# Resolve WAYLAND_DISPLAY from runtime socket if empty or invalid
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
for _ in $(seq 1 50); do
	if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
		break
	fi
	for sock in "$RUNTIME_DIR"/wayland-[0-9]*; do
		if [ -S "$sock" ]; then
			export WAYLAND_DISPLAY="$(basename "$sock")"
			break 2
		fi
	done
	sleep 0.1
done

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/asura"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/asura-wallpaper.log" 2>&1

# Virtual machine graphics fallback for wallpaper UI
if [ -z "${LIBGL_ALWAYS_SOFTWARE:-}" ]; then
	if [ -n "${ASURA_IS_VM:-}" ] || \
	   grep -qa "VirtualBox\|VMware\|QEMU\|KVM" /sys/class/dmi/id/product_name 2>/dev/null || \
	   grep -qa "VirtualBox\|VMware\|QEMU\|KVM\|innotek" /sys/class/dmi/id/sys_vendor 2>/dev/null || \
	   lspci 2>/dev/null | grep -qi "VMware\|VirtualBox\|QEMU"; then
		export LIBGL_ALWAYS_SOFTWARE=1
	fi
fi

exec asura-wallpaper
