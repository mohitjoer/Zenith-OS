#!/bin/sh
exec 2>&1
# Layer 3 Tuning: scx_lavd (Latency-Aware Virtual Deadline eBPF scheduler)
# Pins games and interactive UI threads to Performance Cores (P-Cores)
# and steers background workers to Efficiency Cores (E-Cores).

if [ ! -x /usr/bin/scx_lavd ]; then
	echo "scx-lavd: /usr/bin/scx_lavd not found, pausing service"
	pause
fi

# Ensure eBPF filesystem is mounted
if ! mountpoint -q /sys/fs/bpf; then
	mount -t bpf bpffs /sys/fs/bpf 2>/dev/null || true
fi

# Run scx_lavd with autopower policy
exec /usr/bin/scx_lavd --autopower
