# Asura OS Low-Latency NVMe & Storage I/O Elevator Rules

# Layer 3 Tuning: Kyber NVMe I/O elevator prioritizes synchronous reads and interactive frame pacing.

# Set Kyber elevator for all NVMe SSD storage devices
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="kyber"

# Set BFQ scheduler for non-rotational SATA SSDs and eMMC storage
ACTION=="add|change", KERNEL=="sd[a-z]|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="bfq"
